{
  "status": "{{ status | default('ready') }}",
  "currency": "USD",
  {#- name = <provider>/<bare> per the platform service-naming convention
      (unitysvc PR #1196 / issue #1138). #}
  "name": "{{ provider_name }}/{{ offering_name }}",
{%- if list_price %}
{#- Price-cell copy follows the marketplace description grammar
    (unitysvc/unitysvc#1886, PR #1887):

        <amount> [ ~<intent> <PILL> ] [ | <hover note> ]

    The cell used to read "Free (BYOK)" — one flat string, with the
    parenthetical doing badge work the parser cannot see, and the upstream
    rate reachable only by opening the service page. Now the amount is Free,
    *why* it is free rides the badge slot as a pill (a bare `~` selects the
    default intent — a saving — which is the green fill; `~deal` / `~coupon` /
    `~info` are the other registers), and Cohere's reference rate rides the
    `|` note. That note is taken first and consumed to end-of-string, which
    makes everything in it inert — a rate card full of "/" and "per" is safe
    there and ONLY there.

    Models with no rate in the upstream data render "Free ~ BYOK" alone. That
    is correct, not incomplete: there is no number to state.

    Composed here rather than written into the param file because
    scripts/update_params.py rebuilds list_price on the nightly populate run
    and would drop a hand-edited description within a day. It overrides only
    `description`; `price`/`type` are carried through untouched, and
    `payout_price` (seller-facing, same dict upstream) is not touched at all. #}
{%- set _rate = (' | usage is billed by ' ~ provider_display_name ~ ' directly at ' ~ pricing_note) if pricing_note else '' %}
  "list_price": {{ dict(list_price, description='Free ~ BYOK' ~ _rate) | tojson }},
{%- endif %}
  "user_access_interfaces": {
    "provider_api": {
      "access_method": "http",
      "base_url": "${API_GATEWAY_BASE_URL}/{{ provider_name }}",
      "routing_key": {"model": "{{ offering_name }}"}
    }
  },
  {#- Every document below is DERIVED from what this service is: its
      capability and the request dialects it accepts (unitysvc/unitysvc#1899).
      The catalog-wide shape lives in unitysvc-data's `llm_example_collection`
      preset, so a new example flavour or a fixed preset reaches this repo on
      the next release rather than through a PR here.

      A collection covers ONE capability, so the four-way dispatch stays. Two
      Cohere specifics ride the declaration instead of being repeated on every
      document:

      * `version_prefix` — Cohere serves the OpenAI-compatible surface at
        /compatibility/v1 and its native v2 surface at /v2. `params`
        broadcasts to every preset that DECLARES the parameter; the
        Cohere-SDK example declares none, so it keeps its own path exactly as
        the hand-written block left it.
      * `cohere` is a dialect like any other — the SDK example and the
        image-embedding presets declare `applies_to.dialect = cohere`, so
        naming it in `formats` selects them. -#}
  "documents": {
{%- if is_transcription %}
    "$llm_example_collection": {
      "capabilities": ["speech-transcribe"],
      "formats": ["openai"],
      "upstream_dialect": "openai",
      "params": {"version_prefix": "/compatibility/v1"},
      "sleep": 5
    }
{%- elif is_image_embedding %}
    "$llm_example_collection": {
      "capabilities": ["embed"],
      "formats": ["cohere"],
      "upstream_dialect": "openai",
      "params": {"version_prefix": "/v2"},
      "sleep": 5
    }
{%- elif service_type == "embedding" %}
    "$llm_example_collection": {
      "capabilities": ["embed"],
      "formats": ["openai"],
      "upstream_dialect": "openai",
      "params": {"version_prefix": "/compatibility/v1"},
      "sleep": 5
    }
{%- else %}
    "$llm_example_collection": {
      "capabilities": ["chat"],
      "formats": ["openai", "anthropic", "cohere"],
      "upstream_dialect": "openai",
      "tools": true,
      "params": {"version_prefix": "/compatibility/v1"},
      "sleep": 5
    }
{%- endif %}
  }
}
